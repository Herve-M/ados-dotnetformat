{
  "name": "ados-dotnetformat",
  "description": "Azure DevOps dotnet-format task",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "glob-exec --parallel --foreach \"src/**/task.json\" -- npx mocha {{file.dir}}/test/_suite.js",
    "test:ci": "echo \"Warning: no test specified\"",
    "init:dev": "node scripts/init-dev.js",
    "init:ci": "node scripts/init-ci.js",
    "build:dev": "node scripts/build-dev.js",
    "build:ci": "node scripts/build-ci.js",
    "pack:dev": "tfx extension create --manifests vss-extension.json --overrides-file vss-extension.dev.json",
    "clean": "git clean -fdX",
    "prepare": "is-ci || husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Herve-M/ados-dotnetformat.git"
  },
  "author": "MATYSIAK Hervé",
  "private": true,
  "license": "MPL-2.0",
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^13.1.0",
    "@types/mocha": "^8.2.3",
    "glob-exec": "^0.1.1",
    "husky": "^8.0.3",
    "is-ci": "^3.0.0",
    "mocha": "^10.2.0",
    "tfx-cli": "^0.22.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "~20.20"
  }
}
